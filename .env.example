# Plantilla de variables de entorno — copiar a .env y rellenar.
#
# Un ÚNICO .env en la raíz del proyecto alimenta a los tres servicios.
# Si además creas un backend/.env, es fácil editar ese por error y creer
# que está aplicado: el de la raíz es el que mandan a leer tanto
# backend/src/cargarEnv.js como motor-analitico/servicio_interno.py.
#
# Node y Python leen el .env UNA SOLA VEZ, al arrancar. Si lo cambias con
# los servicios corriendo, reinicia AMBOS.

# ── Secretos ────────────────────────────────────────────────────────────
# Clave de cifrado de la cartera persistida (AES-256-GCM). 32 bytes en hex:
#   python -c "import secrets; print(secrets.token_hex(32))"
PORTFOLIO_ENCRYPTION_KEY=

# Token compartido entre el backend Node y el motor Python. Cualquier
# string largo y aleatorio, pero IDÉNTICO en los dos lados: si no coinciden,
# el motor responde 401 y el escáner se queda vacío.
ANALYTICS_SERVICE_INTERNAL_TOKEN=

# Firma la cookie de sesión que sostiene la carga y el diagnóstico de
# cartera. Otro string largo y aleatorio.
SESSION_SECRET=

# ── PostgreSQL ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_financiero
DB_USER=postgres
DB_PASSWORD=

# ── Puertos y conexión entre servicios ──────────────────────────────────
API_PORT=3000
ANALYTICS_SERVICE_HOST=127.0.0.1
ANALYTICS_SERVICE_PORT=8001

# ── Riesgo ──────────────────────────────────────────────────────────────
# Tope duro de apalancamiento en Fase 1 (Aceleración). El motor nunca lo
# supera: hay un min() explícito que lo garantiza (regla protegida nº1).
LEVERAGE_HARD_CAP_FASE1=5

# ── Declaradas pero todavía sin leer por el código ──────────────────────
# Se dejan documentadas porque describen parámetros que la máquina de
# fases ya usa, pero hoy con valores por defecto en ParametrosRiesgo
# (motor-analitico/riesgo/maquina_fases.py) en vez de tomarlos de aquí.
# Cambiarlas ahora no tiene efecto.
LEVERAGE_HARD_CAP_FASE2=3
FASE_TRANSICION_MULTIPLO=3
FASE_TRANSICION_DRAWDOWN_PCT=-30
FASE_TRANSICION_MAX_OPERACIONES=8
